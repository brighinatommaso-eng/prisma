<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	App Transport Security: allow plain http:// to any host.

	The Prisma backend serves plain HTTP on a private network, reached either by a
	LAN address or a Tailscale address, and the user chooses which at runtime. iOS
	blocks cleartext HTTP by default, so without this every request fails with
	URLError -1022.

	NSAllowsLocalNetworking alone is not enough: it does not cover a fully
	qualified Tailscale MagicDNS name. And if both keys are set, iOS ignores
	NSAllowsArbitraryLoads. This app is sideloaded for personal use and never goes
	to App Review, so the broad exception is acceptable here. Tailscale encrypts
	the traffic between the devices.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Shown in the iOS prompt the first time the app contacts a LAN address. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Prisma connects to your own music server when its address is on your local network.</string>
	<!--
	Background audio: keeps playback going with the screen locked or the app in
	the background. Without it iOS suspends the app and the music stops.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!--
	Playlists exported by the Demus app: files ending in .playlist.

	The type is imported, not exported: the format belongs to Demus, and Prisma only
	says it can read it. It is declared under Prisma's own identifier because the
	identifier Demus uses for its exports, if it declares one at all, is not known;
	iOS matches an undeclared file to this type by its extension.

	CFBundleDocumentTypes is what puts Prisma in the share sheet and in "Open in"
	for such a file. Alternate, not Owner: Prisma is one more app that can take the
	file, never the default one.
	-->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.brighina.prisma.demus-playlist</string>
			<key>UTTypeDescription</key>
			<string>Demus playlist</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>playlist</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Demus playlist</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.brighina.prisma.demus-playlist</string>
			</array>
		</dict>
	</array>
	<!--
	Not in place. Prisma reads a playlist file once, into memory, and never writes
	it back, so it has no use for the original: with this set to false iOS gives it
	a private copy in Documents/Inbox, which is still there after the sharing app
	has deleted its temporary export, and which Prisma removes as soon as it has
	read it. Opening in place would instead hand over a security-scoped URL into
	another app's storage that can vanish before it is read. Stated explicitly
	because an app that declares document types is expected to say which it is.
	-->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- Filled by CI with the short commit SHA; shown on the Settings tab. -->
	<key>PrismaCommitSHA</key>
	<string>$(PRISMA_COMMIT_SHA)</string>
</dict>
</plist>
